rules_version = '2';
// 월간꽃밥 (goodbabstory) 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 통째로 붙여 넣고 [게시]를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // 관리자: 아이디 yeriberry 로 로그인한 사람
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'yeriberry@goodbabstory.admin';
    }
    function validId(id) { return id.matches('^[0-9]{4}-[0-9]{2}$'); }
    function postPath(id) { return /databases/$(database)/documents/posts/$(id); }
    function issuePath(issue) { return /databases/$(database)/documents/issues/$(issue); }
    function likePath(issue) { return /databases/$(database)/documents/issues/$(issue)/likes/$(request.auth.uid); }
    function posterPath() { return /databases/$(database)/documents/posters/$(request.auth.uid); }
    function likesBefore(issue) { return exists(issuePath(issue)) ? get(issuePath(issue)).data.likes : 0; }

    // ── 소식지 글: 공개된 글은 누구나 읽기, 쓰기는 관리자만 ──
    match /posts/{id} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && validId(id)
        && request.resource.data.keys().hasOnly(['no', 'title', 'summary', 'body', 'published', 'updatedAt']);
      allow delete: if isAdmin();

      // 글 속 사진
      match /images/{img} {
        allow read: if isAdmin() || get(postPath(id)).data.published == true;
        allow write: if isAdmin();
      }
    }

    // ── 좋아요·댓글 (호마다 하나) ──
    match /issues/{issue} {
      allow read: if true;
      allow create: if signedIn() && validId(issue)
        && request.resource.data.keys().hasOnly(['likes'])
        && request.resource.data.likes == 1
        && !exists(likePath(issue)) && existsAfter(likePath(issue));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['likes'])
        && ((request.resource.data.likes == resource.data.likes + 1
              && !exists(likePath(issue)) && existsAfter(likePath(issue)))
          || (request.resource.data.likes == resource.data.likes - 1
              && exists(likePath(issue)) && !existsAfter(likePath(issue))));
      allow delete: if false;

      // 누가 하트를 눌렀는지 (본인 것만 확인 가능)
      match /likes/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && getAfter(issuePath(issue)).data.likes == likesBefore(issue) + 1;
        allow delete: if signedIn() && request.auth.uid == uid
          && getAfter(issuePath(issue)).data.likes == likesBefore(issue) - 1;
        allow update: if false;
      }

      // 댓글: 이름 20자·내용 500자까지, 같은 사람은 30초에 한 번
      // 수정·삭제는 댓글 비밀번호가 맞을 때만, 관리자는 언제든 삭제 가능
      match /comments/{cid} {
        function keyPath() { return /databases/$(database)/documents/issues/$(issue)/commentKeys/$(cid); }
        function proofPath() { return /databases/$(database)/documents/issues/$(issue)/commentProofs/$(cid); }
        function passwordOk() {
          // 이번 요청에서 방금 입력한 비밀번호만 인정 (예전에 입력한 기록은 무효)
          return existsAfter(proofPath()) && exists(keyPath())
            && getAfter(proofPath()).data.at == request.time
            && getAfter(proofPath()).data.hash == get(keyPath()).data.hash;
        }
        allow read: if true;
        allow create: if signedIn() && validId(issue)
          && request.resource.data.keys().hasOnly(['name', 'text', 'at'])
          && request.resource.data.at == request.time
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && getAfter(posterPath()).data.lastAt == request.time
          && existsAfter(keyPath());
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && request.resource.data.editedAt == request.time
          && passwordOk();
        allow delete: if isAdmin() || passwordOk();
      }

      // 댓글 비밀번호(암호화된 값). 아무도 읽을 수 없음
      match /commentKeys/{cid} {
        function commentPath() { return /databases/$(database)/documents/issues/$(issue)/comments/$(cid); }
        allow read: if false;
        allow create: if request.resource.data.keys().hasOnly(['hash'])
          && request.resource.data.hash is string && request.resource.data.hash.size() == 64
          && !exists(commentPath()) && existsAfter(commentPath());
        allow update: if false;
        allow delete: if !existsAfter(commentPath());
      }

      // 수정·삭제할 때 입력한 비밀번호 확인용. 아무도 읽을 수 없음
      match /commentProofs/{cid} {
        allow read: if false;
        allow create, update: if request.resource.data.keys().hasOnly(['hash', 'at'])
          && request.resource.data.hash is string && request.resource.data.hash.size() == 64
          && request.resource.data.at == request.time;
        allow delete: if false;
      }
    }

    // 연속 댓글 막기용 기록 (마지막으로 댓글 쓴 시각)
    match /posters/{uid} {
      allow read: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(30, 's');
      allow delete: if false;
    }
  }
}
