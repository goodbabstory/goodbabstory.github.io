rules_version = '2';
// 월간꽃밥 (goodbabstory) 좋아요·댓글 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 통째로 붙여 넣고 [게시]를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function issuePath(issue) { return /databases/$(database)/documents/issues/$(issue); }
    function likePath(issue) { return /databases/$(database)/documents/issues/$(issue)/likes/$(request.auth.uid); }
    function posterPath() { return /databases/$(database)/documents/posters/$(request.auth.uid); }
    function likesBefore(issue) { return exists(issuePath(issue)) ? get(issuePath(issue)).data.likes : 0; }

    // 소식지 한 호 = 좋아요 숫자 하나. 숫자는 '내 하트'를 넣거나 뺄 때만 1씩 바뀜
    match /issues/{issue} {
      allow read: if true;
      allow create: if signedIn()
        && issue.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['likes'])
        && request.resource.data.likes == 1
        && !exists(likePath(issue)) && existsAfter(likePath(issue));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['likes'])
        && ((request.resource.data.likes == resource.data.likes + 1
              && !exists(likePath(issue)) && existsAfter(likePath(issue)))
          || (request.resource.data.likes == resource.data.likes - 1
              && exists(likePath(issue)) && !existsAfter(likePath(issue))));
      allow delete: if false;

      // 누가 하트를 눌렀는지 (본인 것만 확인 가능)
      match /likes/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && getAfter(issuePath(issue)).data.likes == likesBefore(issue) + 1;
        allow delete: if signedIn() && request.auth.uid == uid
          && getAfter(issuePath(issue)).data.likes == likesBefore(issue) - 1;
        allow update: if false;
      }

      // 댓글: 누구나 읽기, 이름 20자·내용 500자까지, 같은 사람은 30초에 한 번
      // 본인 댓글은 본인이 지울 수 있고, 관리자는 Firebase 콘솔에서 지우면 됨
      match /comments/{cid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['name', 'text', 'uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && getAfter(posterPath()).data.lastAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // 연속 댓글 막기용 기록 (마지막으로 댓글 쓴 시각)
    match /posters/{uid} {
      allow read: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(30, 's');
      allow delete: if false;
    }
  }
}
